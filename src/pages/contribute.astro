---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ContributeForm from '../components/forms/ContributeForm.astro';
---

<Base
  title="Contribute"
  description="Join our team of volunteer software developers, UX designers, product managers and writers."
>
  <Section theme="light">
    <div class="text-center">
      <h1 class="type-section mx-auto max-w-3xl">Your skills save millions of lives</h1>
      <p class="type-intro mx-auto mt-8 max-w-3xl">
        Join our passionate team of volunteer software developers, UX designers, product managers, and
        writers to build the software platform to develop treatments for monogenic rare diseases
      </p>

      <h2 class="type-lead mt-20">Sign up here</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed">
        We value every one of your contributions. You can spend as much time or as little as you like
        to volunteer and build the software platform
      </p>

      <div class="mt-10">
        <ContributeForm />
      </div>
    </div>
  </Section>
</Base>
