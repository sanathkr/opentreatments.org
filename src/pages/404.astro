---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
---

<Base title="Page not found" indexable={false}>
  <Section theme="light" space="loose">
    <div class="mx-auto max-w-2xl text-center">
      <h1 class="text-4xl md:text-5xl">We couldn't find that page</h1>
      <p class="mt-8 text-lg leading-relaxed">
        The page you were looking for may have moved or no longer exists.
      </p>
      <Button href="/" variant="outline" class="mt-10">Back to the home page</Button>
    </div>
  </Section>
</Base>
