---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import ContactForm from '../components/forms/ContactForm.astro';
import { site } from '../data/site';
---

<Base title="Contact Us" description="Get in touch with the Open Treatments Foundation.">
  <Section theme="light">
    <h1 class="type-section">Contact us</h1>
    <p class="type-intro mt-6 max-w-3xl">
      Our mission to enable treatments for all genetic diseases regardless of rarity or geography is
      an ambitious one. We cannot do it without the support of advocacy organizations, bio-tech
      companies and government entities working towards the same goal.
    </p>

    <div class="mt-16 grid gap-12 md:grid-cols-2 md:gap-16">
      <div>
        <h2 class="type-lead">Reach out.</h2>
        <a
          href={`mailto:${site.email}`}
          class="mt-4 inline-block text-lg underline underline-offset-4 hover:opacity-70"
        >
          {site.email}
        </a>
      </div>

      <ContactForm />
    </div>
  </Section>
</Base>
