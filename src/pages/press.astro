---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PressCard from '../components/PressCard.astro';
import { pressReleases, news, interviews } from '../data/press';
---

<Base
  title="Press"
  description="The latest news, press releases and interviews about the Open Treatments Foundation."
>
  <Section theme="brand" space="loose">
    <h1 class="type-section mx-auto max-w-4xl text-center">
      Check out the latest news and stories about OpenTreatments
    </h1>
  </Section>

  <Section theme="white">
    <h2 class="type-section">Press Releases</h2>
    <ul class="mt-10 grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {pressReleases.map((item) => <li><PressCard item={item} /></li>)}
    </ul>
  </Section>

  <Section theme="light">
    <h2 class="type-section">News</h2>
    <ul class="mt-10 grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {news.map((item) => <li><PressCard item={item} /></li>)}
    </ul>
  </Section>

  <Section theme="white">
    <h2 class="type-section">Interviews</h2>
    <ul class="mt-10 grid gap-12 sm:grid-cols-2 lg:grid-cols-3">
      {interviews.map((item) => <li><PressCard item={item} /></li>)}
    </ul>
  </Section>
</Base>
