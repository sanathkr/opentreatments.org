---
import Base from '../layouts/Base.astro';
import PersonRow from '../components/PersonRow.astro';
import { advisors } from '../data/people';
---

<Base title="Advisors" description="Meet the advisors to the Open Treatments Foundation.">
  <section class="bg-cream py-14 md:py-20">
    <div class="mx-auto max-w-[1500px] px-[3%]">
      <h1 class="type-section text-center">Meet our Advisors</h1>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto max-w-[1500px] space-y-16 px-[3%] md:space-y-24">
      {advisors.map((person, i) => <PersonRow person={person} index={i} />)}
    </div>
  </section>
</Base>
