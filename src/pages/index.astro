---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import LogoGrid from '../components/LogoGrid.astro';
import OverlapCard from '../components/OverlapCard.astro';
import WaitlistForm from '../components/forms/WaitlistForm.astro';
import { collaborators, pilots } from '../data/logos';
import { site } from '../data/site';
import { img } from '../lib/images';

const hero = img('hero-home.jpeg');

/**
 * The three coloured panels below the hero. Each image is a solid colour block
 * that acts as the card background, with the text sitting on top of it.
 */
const pillars = [
  {
    image: 'icon-our-mission.png',
    title: 'Our Mission',
    copy: 'Our Goal, Vision and Commitment',
    href: '/what-we-stand-for',
  },
  {
    image: 'icon-our-platform.png',
    title: 'Our Platform',
    copy: 'A software to accelerate treatments',
    href: '/platform',
  },
  {
    image: 'icon-get-involved.png',
    title: 'Get Involved',
    copy: 'Partner, Volunteer and Donate',
    href: '/contact-us',
  },
];
---

<Base title={site.name}>
  {/* Hero */}
  <div class="relative isolate flex min-h-[560px] items-center md:min-h-[728px]">
    <Image
      src={hero}
      alt=""
      widths={[800, 1280, 1920]}
      sizes="100vw"
      class="absolute inset-0 -z-10 h-full w-full object-cover"
      loading="eager"
      fetchpriority="high"
    />
    {/* The original overlays the photo with black at 60%. */}
    <div class="absolute inset-0 -z-10 bg-black/60"></div>

    <div class="mx-auto w-full max-w-[1036px] px-6 py-24 text-center text-white md:px-10">
      <h1 class="type-display">Enabling treatments for rare diseases</h1>
      <p class="type-lead mt-8">
        OpenTreatments software platform streamlines therapy development for any monogenic rare
        disease regardless of rarity and geography
      </p>
      <Button href="/platform" variant="light" class="mt-10">Explore Our Platform</Button>
    </div>
  </div>

  {/* Three coloured pillars */}
  <section class="bg-white py-14 md:py-16">
    <div class="mx-auto max-w-[1500px] px-[3%]">
      <ul class="grid gap-6 md:grid-cols-3 md:gap-[2.7%]">
        {
          pillars.map((pillar) => (
            <li>
              <a href={pillar.href} class="group relative block overflow-hidden">
                <Image
                  src={img(pillar.image)}
                  alt=""
                  widths={[500, 950]}
                  sizes="(min-width: 768px) 30vw, 94vw"
                  class="aspect-[947/536] w-full object-cover transition-transform duration-300 group-hover:scale-105"
                  loading="lazy"
                />
                <div class="absolute inset-0 flex flex-col justify-center px-[9%] text-white">
                  <h2 class="type-lead">{pillar.title}</h2>
                  <p class="mt-2">{pillar.copy}</p>
                </div>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Empowered to take action: white card overlapping the photo */}
  <OverlapCard image={img('home-empowered-to-take-action.jpg')} cardSide="left" cardBg="white" theme="slate">
    <h2 class="type-section">Empowered to take action</h2>
    <p class="mt-7">
      When it comes to finding treatments for rare diseases patients lead the charge. Without a
      formal background, they must learn biology, speak like a scientist, raise millions of dollars,
      conduct research, and move mountains to find a treatment. They are often asked to make
      life-altering decisions without much background, or support. OpenTreatments Foundation empowers
      these patient organizations by giving them the software tools to make the right decisions at
      the right time, with a system of support.
    </p>
  </OverlapCard>

  {/* Simplify the maze: image left, text right, no card */}
  <section class="bg-slate text-white">
    <div class="mx-auto grid max-w-[1500px] items-center gap-10 px-[3%] py-14 md:grid-cols-2 md:gap-[6%] md:py-16">
      <Image
        src={img('home-simplify-the-maze.png')}
        alt=""
        widths={[600, 1000]}
        sizes="(min-width: 768px) 42vw, 94vw"
        class="w-full object-contain"
        loading="lazy"
      />
      <div>
        <h2 class="type-section">Simplify the maze</h2>
        <p class="mt-7">
          Patient organizations are left to navigate the complex treatment development maze. Each
          patient group creates their own research program without a deep understanding of the risks,
          benefits, and pitfalls of their decisions. OpenTreatments platform simplifies the maze by
          bringing in real-world experience along every step leading to faster treatments.
        </p>
      </div>
    </div>
  </section>

  {/* Collaborators */}
  <Section theme="white">
    <h2 class="type-section text-center">Our Collaborators</h2>
    <div class="mt-14">
      <LogoGrid logos={collaborators} columns={4} size="large" />
    </div>
  </Section>

  {/* Platform teaser */}
  <section class="bg-cream">
    <div class="mx-auto grid max-w-[1500px] items-center gap-10 px-[3%] py-16 md:grid-cols-[54%_1fr] md:gap-[5%] md:py-20">
      <Image
        src={img('platform-roadmap.png')}
        alt="A treatment roadmap in the OpenTreatments platform"
        widths={[700, 1100]}
        sizes="(min-width: 768px) 54vw, 94vw"
        class="w-full object-contain"
        loading="lazy"
      />
      <div>
        <h2 class="type-section">OpenTreatments Platform</h2>
        <p class="type-lead mt-7">
          A software platform to give patients the tools and technology to build treatments for any
          monogenic rare disease
        </p>
        <Button href="/platform" variant="outline" class="mt-9">Learn more</Button>
      </div>
    </div>
  </section>

  {/* Pilots + waitlist */}
  <Section theme="slate">
    <div class="text-center">
      <h2 class="type-section">Try OpenTreatments Platform</h2>
      <p class="type-lead mt-6">
        We are currently piloting OpenTreatments platform with 4 patient led organizations
      </p>
      <div class="mx-auto mt-14 max-w-4xl">
        <LogoGrid logos={pilots} columns={4} plate size="large" />
      </div>
      <p class="type-lead mx-auto mt-16 max-w-3xl">
        Join the waitlist to get priority access when we open more broadly.
      </p>
      <div class="mt-9">
        <WaitlistForm />
      </div>
    </div>
  </Section>

  {/* Testimonial: cream card overlapping the photo */}
  <OverlapCard image={img('person-geoff-rhyne.png')} alt="Geoff Rhyne" cardSide="left" cardBg="cream" theme="white">
    <blockquote class="type-lead">
      “OpenTreatments will enable IDefine to accelerate our mission by distilling down the necessary
      steps in the development of a gene therapy program into a concise and approachable plan”
    </blockquote>
    <p class="mt-7 opacity-75">
      — Geoff Rhyne, Co-Founder and CEO of IDefine, a patient-led organization tackling Kleefstra
      Syndrome caused by mutations in EHMT1 gene.
    </p>
  </OverlapCard>
</Base>
