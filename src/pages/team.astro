---
import Base from '../layouts/Base.astro';
import Section from '../components/Section.astro';
import PersonCard from '../components/PersonCard.astro';
import { teamGroups } from '../data/people';
---

<Base
  title="Team"
  description="Our team is a group of passionate people who strive to empower the rare disease community."
>
  <Section theme="light">
    <h1 class="text-center text-4xl md:text-5xl">Meet Our Team</h1>
    <p class="mx-auto mt-6 max-w-2xl text-center text-lg leading-relaxed">
      Our team is a group of passionate people who strive to empower the rare disease community.
    </p>

    <div class="mt-16 space-y-20">
      {
        teamGroups.map((group) => (
          <div>
            <h2 class="text-center text-3xl">{group.heading}</h2>
            <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-10 sm:gap-x-8 sm:gap-y-12 lg:grid-cols-4">
              {group.members.map((person) => (
                <li>
                  <PersonCard person={person} />
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </Section>
</Base>
