---
import Base from '../../layouts/Base.astro';
import { getWikiTree, wikiUrl } from '../../lib/wiki';

const tree = await getWikiTree();

/**
 * `indexable={false}` mirrors the Super.site wiki, which served
 * `robots.txt: Disallow: /`. Remove it to let this be found in search.
 */
---

<Base
  title="Connect Wiki"
  description="Orientation to OpenTreatments Connect — its vision, roadmap, culture and teams."
  indexable={false}
>
  <section class="bg-cream py-14 md:py-20">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10">
      <h1 class="type-section">Connect Wiki</h1>
      <p class="type-intro mt-6 max-w-3xl">
        👋 Welcome to OpenTreatments Connect Wiki.
      </p>
      <p class="mt-4 max-w-3xl">
        Follow these links to get a quick orientation to OpenTreatments, the Connect platform, and
        how to contribute.
      </p>
    </div>
  </section>

  <section class="bg-white py-14 md:py-20">
    <div class="mx-auto max-w-[1100px] px-6 md:px-10">
      <ul class="grid gap-x-10 gap-y-12 md:grid-cols-2">
        {
          tree.map((section) => (
            <li>
              <a href={wikiUrl(section.entry)} class="group block">
                <h2 class="type-lead underline-offset-4 group-hover:underline">
                  {section.entry.data.title}
                </h2>
                <p class="mt-2 opacity-80">{section.entry.data.description}</p>
              </a>

              {section.children.length > 0 && (
                <ul class="mt-4 border-l border-black/10 pl-4">
                  {section.children.map((child) => (
                    <li class="py-1">
                      <a href={wikiUrl(child)} class="underline-offset-4 hover:text-brand hover:underline">
                        {child.data.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Base>
