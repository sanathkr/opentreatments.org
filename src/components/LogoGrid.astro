---
import { Image } from 'astro:assets';
import type { Logo } from '../data/logos';
import { img } from '../lib/images';

interface Props {
  logos: Logo[];
  columns?: 2 | 3 | 4;
  /** Logos sit on dark bands in places; give them a white plate there. */
  plate?: boolean;
}

const { logos, columns = 4, plate = false } = Astro.props;

const cols = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-4',
};
---

<ul class={`grid ${cols[columns]} items-center gap-x-8 gap-y-10`}>
  {
    logos.map((logo) => (
      <li class={plate ? 'rounded bg-white p-4' : ''}>
        <Image
          src={img(logo.image)}
          alt={logo.name}
          widths={[240, 480]}
          sizes="(min-width: 768px) 240px, 40vw"
          class="mx-auto h-16 w-auto max-w-full object-contain md:h-20"
          loading="lazy"
        />
      </li>
    ))
  }
</ul>
