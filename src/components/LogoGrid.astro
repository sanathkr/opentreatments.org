---
import { Image } from 'astro:assets';
import type { Logo } from '../data/logos';
import { img } from '../lib/images';

interface Props {
  logos: Logo[];
  columns?: 2 | 3 | 4;
  /** Logos sit on dark bands in places; give them a white plate there. */
  plate?: boolean;
  /** 'large' matches the ~106px tall logos the home page used. */
  size?: 'normal' | 'large';
}

const { logos, columns = 4, plate = false, size = 'normal' } = Astro.props;

const heights = {
  normal: 'h-16 md:h-20',
  large: 'h-20 md:h-[106px]',
};

const cols = {
  2: 'grid-cols-2',
  3: 'grid-cols-2 md:grid-cols-3',
  4: 'grid-cols-2 md:grid-cols-4',
};
---

<ul class={`grid ${cols[columns]} items-center gap-x-8 gap-y-10`}>
  {
    logos.map((logo) => (
      <li class={plate ? 'rounded bg-white p-4' : ''}>
        <Image
          src={img(logo.image)}
          alt={logo.name}
          widths={[240, 480]}
          sizes="(min-width: 768px) 240px, 40vw"
          class={`mx-auto w-auto max-w-full object-contain ${heights[size]}`}
          loading="lazy"
        />
      </li>
    ))
  }
</ul>
