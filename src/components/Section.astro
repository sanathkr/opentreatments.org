---
/**
 * A full-width page band. The `theme` values mirror the six section themes the
 * Squarespace site used, so pages read the same way they did there.
 */
export type Theme = 'white' | 'light' | 'brand' | 'slate' | 'black';

interface Props {
  theme?: Theme;
  class?: string;
  /** Vertical padding. 'tight' for logo strips, 'none' for full-bleed images. */
  space?: 'none' | 'tight' | 'normal' | 'loose';
  id?: string;
}

const { theme = 'white', class: className = '', space = 'normal', id } = Astro.props;

const themes: Record<Theme, string> = {
  white: 'bg-white text-ink',
  light: 'bg-cream text-ink',
  brand: 'bg-brand text-white',
  slate: 'bg-slate text-white',
  black: 'bg-ink text-white',
};

const spacing = {
  none: '',
  tight: 'py-12 md:py-16',
  normal: 'py-16 md:py-24',
  loose: 'py-24 md:py-36',
};
---

<section id={id} class={`${themes[theme]} ${spacing[space]} ${className}`}>
  <div class="mx-auto w-full max-w-6xl px-6 md:px-10">
    <slot />
  </div>
</section>
