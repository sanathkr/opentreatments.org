---
import { Image } from 'astro:assets';
import type { Person } from '../data/people';
import { img } from '../lib/images';

interface Props {
  person: Person;
  /** 'full' shows the long biography (board), 'compact' is a photo + name (team). */
  variant?: 'full' | 'compact';
}

const { person, variant = 'compact' } = Astro.props;
const photo = img(person.photo);
---

{
  variant === 'full' ? (
    <article class="grid gap-8 md:grid-cols-[220px_1fr] md:gap-12">
      <Image
        src={photo}
        alt={person.name}
        widths={[220, 440]}
        sizes="220px"
        class="aspect-square w-full max-w-56 rounded-full object-cover"
        loading="lazy"
      />
      <div>
        <h3 class="text-3xl">{person.name}</h3>
        {person.title && <p class="mt-2 text-lg opacity-70">{person.title}</p>}
        {person.bio && <p class="mt-5 leading-relaxed"><Fragment set:html={person.bio.replace(/\(curegpx4\.org\)/, '(<a class="underline underline-offset-4" href="https://www.curegpx4.org" target="_blank" rel="noopener noreferrer">curegpx4.org</a>)')} /></p>}
      </div>
    </article>
  ) : (
    <article class="text-center">
      <Image
        src={photo}
        alt={person.name}
        widths={[200, 400]}
        sizes="(min-width: 768px) 200px, 45vw"
        class="mx-auto aspect-square w-full max-w-48 rounded-full object-cover"
        loading="lazy"
      />
      <h3 class="mt-5 text-xl">{person.name}</h3>
      {person.title && <p class="mt-1 text-sm opacity-70">{person.title}</p>}
      {person.bioUrl && (
        <a
          href={person.bioUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-3 inline-block text-sm underline underline-offset-4 hover:opacity-60"
        >
          Read Bio
        </a>
      )}
    </article>
  )
}
