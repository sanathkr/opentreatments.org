---
import { Image } from 'astro:assets';
import type { Person } from '../data/people';
import { img } from '../lib/images';

/**
 * A team-grid card: square photo, name, role. The Squarespace original used
 * square (not circular) crops, a 27.2px name and a 25.5px role, all centred.
 */
interface Props {
  person: Person;
  /**
   * Heading level for the name. The team page nests these under group
   * headings, so 'h3' is the default; skipping a level confuses screen readers.
   */
  as?: 'h2' | 'h3';
}

const { person, as: Heading = 'h3' } = Astro.props;
const photo = img(person.photo);
---

<article class="text-center">
  <Image
    src={photo}
    alt={person.name}
    widths={[320, 640]}
    sizes="(min-width: 768px) 22vw, 45vw"
    class="aspect-square w-full object-cover"
    loading="lazy"
  />
  <Heading class="type-lead mt-6">{person.name}</Heading>
  {person.title && <p class="type-intro mt-1">{person.title}</p>}
</article>
