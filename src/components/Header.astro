---
import { Image } from 'astro:assets';
import { mainNav } from '../data/site';
import { img } from '../lib/images';

const logo = img('logo-opentreatments.png');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => href === path;
---

<header class="sticky top-0 z-50 bg-white">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-6 px-6 py-4 md:px-10">
    <a href="/" class="shrink-0" aria-label="Open Treatments Foundation — home">
      <Image src={logo} alt="Open Treatments Foundation" widths={[220, 440]} sizes="180px" class="h-11 w-auto md:h-14" loading="eager" />
    </a>

    {/* Desktop navigation */}
    <nav class="hidden items-center gap-7 lg:flex" aria-label="Main">
      {
        mainNav.map((item) =>
          'children' in item && item.children ? (
            <div class="group relative">
              <button
                type="button"
                class="flex items-center gap-1 py-2 text-[15px] hover:opacity-60"
                aria-expanded="false"
                aria-haspopup="true"
              >
                {item.label}
                <svg width="10" height="6" viewBox="0 0 10 6" aria-hidden="true" class="mt-0.5">
                  <path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5" />
                </svg>
              </button>
              <ul
                class="invisible absolute left-0 top-full min-w-56 bg-white py-2 opacity-0 shadow-lg transition-opacity duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100"
              >
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block px-5 py-2.5 text-[15px] hover:bg-cream"
                      aria-current={isCurrent(child.href) ? 'page' : undefined}
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ) : (
            <a
              href={item.href}
              class="py-2 text-[15px] hover:opacity-60"
              aria-current={isCurrent(item.href!) ? 'page' : undefined}
              {...(item.href!.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              {item.label}
            </a>
          ),
        )
      }
      <a
        href="/contact-us"
        class="bg-brand px-7 py-4 text-sm uppercase tracking-button text-white transition-colors hover:bg-brand-dark"
      >
        Contact Us
      </a>
    </nav>

    {/* Mobile menu trigger */}
    <button
      type="button"
      id="menu-toggle"
      class="p-2 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <span class="sr-only">Toggle menu</span>
      <svg width="26" height="18" viewBox="0 0 26 18" aria-hidden="true">
        <path d="M0 1h26M0 9h26M0 17h26" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>
  </div>

  {/* Mobile menu */}
  <nav id="mobile-menu" class="hidden border-t border-black/10 lg:hidden" aria-label="Main">
    <ul class="px-6 py-4">
      {
        mainNav.map((item) =>
          'children' in item && item.children ? (
            <li class="py-2">
              <span class="block py-1 text-sm uppercase tracking-button opacity-50">{item.label}</span>
              <ul class="pl-4">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block py-2.5">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a
                href={item.href}
                class="block py-2.5"
                {...(item.href!.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
              >
                {item.label}
              </a>
            </li>
          ),
        )
      }
      <li class="pt-4 pb-2">
        <a href="/contact-us" class="inline-block bg-brand px-7 py-3.5 text-sm uppercase tracking-button text-white">
          Contact Us
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
